    <!-- Onboarding -->
    <string name="onboarding_app_bar">Einrichtung</string>
    <string name="onboarding_title">Willkommen bei rubato</string>
    <string name="onboarding_intro">rubato erkennt, was gerade läuft, analysiert den Klang und legt einen sanften Korrektur-EQ darüber. Dafür braucht es ein paar Freigaben.</string>
    <string name="onboarding_step">%1$d. %2$s</string>
    <string name="onboarding_granted">Erteilt</string>
    <string name="onboarding_done_cd">erledigt</string>
    <string name="onboarding_open_cd">offen</string>
    <string name="onboarding_open_settings">Einstellungen öffnen</string>
    <string name="onboarding_open_app_info">App-Info öffnen</string>
    <string name="onboarding_open_battery">Akku-Einstellungen öffnen</string>
    <string name="onboarding_allow">Erlauben</string>
    <string name="onboarding_denied_hint">Abgelehnt? Dann in der App-Info unter Berechtigungen erlauben.</string>
    <string name="onboarding_listener_title">Benachrichtigungszugriff</string>
    <string name="onboarding_listener_text">Damit rubato sieht, welche App was abspielt (Titel, Künstler, Dauer, Pause). Benachrichtigungen selbst werden nicht gelesen.</string>
    <string name="onboarding_listener_restricted">Ist der Schalter gesperrt („Eingeschränkte Einstellung“)? Android sperrt das bei installierten APKs: App-Info → ⋮ → „Eingeschränkte Einstellungen zulassen“, danach hier erneut versuchen.</string>
    <string name="onboarding_audio_title">Audioanalyse</string>
    <string name="onboarding_audio_text">Android verlangt die Mikrofon-Berechtigung (RECORD_AUDIO), damit der Visualizer die Wiedergabe analysieren darf. rubato nimmt nichts auf und nutzt das Mikrofon nicht.</string>
    <string name="onboarding_notifications_title">Benachrichtigungen</string>
    <string name="onboarding_notifications_text">Für die Statusanzeige mit Pause/Fortsetzen und Hinweise nach Updates.</string>
    <string name="onboarding_battery_title">Akku-Optimierung ignorieren</string>
    <string name="onboarding_battery_text">Damit Android den Hintergrunddienst nicht beendet.</string>
    <string name="onboarding_battery_action">Ausnahme anfordern</string>
    <string name="onboarding_install_title">Unbekannte Apps installieren</string>
    <string name="onboarding_install_text">Für den eingebauten Updater, der neue Versionen von GitHub installiert.</string>
    <string name="onboarding_auto_blocker_title">Samsung Auto Blocker ausschalten</string>
    <string name="onboarding_auto_blocker_text">Einstellungen → Sicherheit und Datenschutz → Auto Blocker. Solange er an ist, blockiert er die Installation von APKs und damit die Updates.</string>
    <string name="onboarding_never_sleeping_title">„Nie schlafende Apps“</string>
    <string name="onboarding_never_sleeping_text">Einstellungen → Akku → Hintergrundnutzungslimits → Nie schlafende Apps → rubato hinzufügen. Sonst kann One UI den Dienst trotz Ausnahme einschläfern.</string>
    <string name="onboarding_required_missing">Benachrichtigungszugriff und Audioanalyse sind Pflicht, ohne sie startet der Dienst nicht.</string>
    <string name="onboarding_done">Fertig</string>

